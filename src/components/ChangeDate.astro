---
// "Change the date of a photo": the second tool. It rewrites the date taken
// in the photo's EXIF (what galleries sort by) and prints nothing on the
// picture, so it has its own page for its own search ("change photo
// date", "Foto Datum ändern"), with the editor first, then the steps
// (HowTo), the FAQ (FAQPage) and a way to the date stamp.
import Base from "../layouts/Base.astro"
import ExifEditor from "./ExifEditor.astro"
import GuideLinks from "./GuideLinks.astro"
import InlineAd from "./InlineAd.astro"
import ToolLink from "./ToolLink.astro"
import { exifGuidePages, href, pathOf, stampGuidePages, t, type Locale } from "../i18n"

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const strings = t(locale)
const page = strings.exif

const howToJsonLd = {
  "@type": "HowTo",
  name: page.stepsTitle,
  description: page.description,
  totalTime: "PT1M",
  estimatedCost: { "@type": "MonetaryAmount", currency: "EUR", value: "0" },
  tool: page.tools.map((name) => ({ "@type": "HowToTool", name })),
  step: page.steps.map((text, index) => ({ "@type": "HowToStep", position: index + 1, text })),
}
const faqJsonLd = {
  "@type": "FAQPage",
  mainEntity: page.faq.map(({ q, a }) => ({ "@type": "Question", name: q, acceptedAnswer: { "@type": "Answer", text: a } })),
}
---

<Base locale={locale} page="exif" title={page.title} description={page.description} schema={[howToJsonLd, faqJsonLd]}>
  <div class="flex flex-wrap items-end justify-between gap-x-6 gap-y-3 pt-6 pb-5 sm:pt-8">
    <div class="min-w-0">
      <h1 class="mb-1.5 text-[28px] leading-tight font-semibold tracking-tight sm:text-4xl">{page.h1}</h1>
      <p class="max-w-150 text-[15px] text-muted sm:text-base">{page.subtitle}</p>
    </div>
    <p class="font-mono text-[13px] text-muted">{strings.home.facts.join(" · ")}</p>
  </div>

  <ExifEditor locale={locale} />

  <section aria-labelledby="steps" class="max-w-170 pt-10 sm:pt-12">
    <h2 id="steps" class="mb-4 text-xl font-semibold tracking-tight sm:text-[22px]">{page.stepsTitle}</h2>
    <ol class="mb-6 list-decimal space-y-2 pl-6">
      {page.steps.map((step) => <li>{step}</li>)}
    </ol>
    <aside class="flex gap-3 rounded-xl bg-accent-soft p-4 ring-1 ring-accent/25 sm:p-5" aria-label={page.tipTitle}>
      <svg class="size-5 flex-none text-accent" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
        <path
          fill-rule="evenodd"
          clip-rule="evenodd"
          d="M18 10a8 8 0 1 1-16 0 8 8 0 0 1 16 0Zm-7-4a1 1 0 1 1-2 0 1 1 0 0 1 2 0ZM9 9a.75.75 0 0 0 0 1.5h.253a.25.25 0 0 1 .244.304l-.459 2.066A1.75 1.75 0 0 0 10.747 15H11a.75.75 0 0 0 0-1.5h-.253a.25.25 0 0 1-.244-.304l.459-2.066A1.75 1.75 0 0 0 9.253 9H9Z"
        ></path>
      </svg>
      <div>
        <h3 class="text-sm font-semibold text-accent-ink">{page.tipTitle}</h3>
        <p class="mt-1.5 text-sm/6 text-accent-ink/90">{page.tip}</p>
      </div>
    </aside>
  </section>

  <!-- Away from the editor: AdSense forbids ads right next to its buttons. -->
  <InlineAd locale={locale} />

  <section aria-labelledby="faq" class="pt-10 sm:pt-12">
    <h2 id="faq" class="mb-2 text-xl font-semibold tracking-tight sm:text-[22px]">{page.faqTitle}</h2>
    <dl class="grid gap-x-10 sm:grid-cols-2">
      {
        page.faq.map(({ q, a }) => (
          <div class="border-b border-line py-4">
            <dt class="mb-1 font-semibold">{q}</dt>
            <dd class="m-0 text-[15px] text-muted">{a}</dd>
          </div>
        ))
      }
    </dl>
  </section>

  <!-- The other tool: the date printed on the picture. -->
  <ToolLink id="stamp" tool="stamp" title={page.stamp.title} body={page.stamp.body} cta={page.stamp.cta} href={href(pathOf("home", locale))} />

  <section aria-labelledby="guides" class="pt-10 pb-4 sm:pt-12">
    <h2 id="guides" class="mb-3 text-xl font-semibold tracking-tight sm:text-[22px]">{strings.home.guidesTitle}</h2>
    <GuideLinks locale={locale} guides={[...exifGuidePages, ...stampGuidePages]} />
  </section>
</Base>
