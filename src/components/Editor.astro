---
// The photo editor. The markup is static HTML (good for SEO and first
// paint); src/lib/editor.ts brings it to life in the browser. Strings for
// the dynamic parts travel in data-strings.
//
// Two columns on a computer: the photos (drop zone, progress, thumbnails)
// and the settings (style, format, position, size, saving). On a phone they
// stack in that order: add photos, adjust, save.
import PhotoColumn from "./PhotoColumn.astro"
import SaveActions from "./SaveActions.astro"
import Select from "./Select.astro"
import { t, type Locale } from "../i18n"
import { formatDate, type StampPosition, type StampStyle } from "../lib/stamp"

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const strings = t(locale)
const s = strings.editor
const sample = new Date(2026, 6, 14, 18, 30)
const sampleText = formatDate(sample, strings.dateFormats[0])
const styles = Object.entries(s.styles) as [StampStyle, string][]
const positions: StampPosition[] = ["top-left", "top-right", "bottom-left", "bottom-right"]
const corner: Record<StampPosition, string> = {
  "top-left": "items-start justify-start",
  "top-right": "items-start justify-end",
  "bottom-left": "items-end justify-start",
  "bottom-right": "items-end justify-end",
}
---

<div
  class="@container flex flex-wrap overflow-hidden rounded-2xl border border-line bg-surface"
  data-editor
  data-strings={JSON.stringify(s)}
  data-default-format={strings.dateFormats[0]}
  data-formats={JSON.stringify(strings.dateFormats)}
  data-sample={sample.toISOString()}
>
  <PhotoColumn locale={locale} />

  <div class="flex min-w-0 flex-[1_1_320px] flex-col gap-5 border-t border-line p-4 sm:p-5 lg:border-t-0 lg:border-l">
    <fieldset class="m-0 flex min-w-0 flex-col gap-5 border-0 p-0" data-options>
      <fieldset class="m-0 min-w-0 border-0 p-0">
        <legend class="mb-2 p-0 text-[13px] font-semibold">{s.style}</legend>
        <div class="grid grid-cols-3 gap-2">
          {
            styles.map(([value, name]) => (
              <label class="group flex cursor-pointer flex-col gap-1.5 rounded-lg border border-line bg-surface p-1.5 transition hover:border-line-strong has-checked:border-accent has-checked:ring-1 has-checked:ring-accent has-focus-visible:outline-2 has-focus-visible:outline-accent has-disabled:cursor-not-allowed has-disabled:opacity-60">
                <input class="sr-only" type="radio" name="style" value={value} />
                <span class="flex h-13 items-end justify-end overflow-hidden rounded bg-photo p-1.5">
                  <span class="stamp text-[10px]" data-style={value} data-stamp-sample>
                    {sampleText}
                  </span>
                </span>
                <span class="text-center text-[13px] group-has-checked:font-semibold">{name}</span>
              </label>
            ))
          }
        </div>
      </fieldset>

      <Select name="format" label={s.format} options={strings.dateFormats.map((format) => ({ value: format, label: formatDate(sample, format) }))} />

      <fieldset class="m-0 min-w-0 border-0 p-0">
        <legend class="mb-2 p-0 text-[13px] font-semibold">
          {s.position} <span class="font-normal text-muted">· <span data-position-label>{s.positions["bottom-right"]}</span></span>
        </legend>
        <div class="grid grid-cols-2 grid-rows-[repeat(2,3.25rem)] gap-1 rounded-lg bg-photo p-1">
          {
            positions.map((position) => (
              <label class={`group flex cursor-pointer overflow-hidden rounded-md bg-white/4 px-2.5 py-2 transition ${corner[position]} hover:bg-white/8 has-checked:bg-accent/16 has-checked:ring-2 has-checked:ring-accent has-checked:ring-inset has-focus-visible:outline-2 has-focus-visible:outline-accent has-disabled:cursor-not-allowed`}>
                <input class="sr-only" type="radio" name="position" value={position} aria-label={s.positions[position]} />
                <span class="stamp text-[12px] opacity-30 transition-opacity group-has-checked:opacity-100" data-style="retro" data-stamp-sample data-stamp-live>
                  {sampleText}
                </span>
              </label>
            ))
          }
        </div>
      </fieldset>

      <div>
        <label for="size" class="mb-1 flex justify-between text-[13px] font-semibold">
          {s.size} <span class="font-normal text-muted" data-size-label>{s.sizes.medium}</span>
        </label>
        <input id="size" type="range" name="size" min="2" max="10" step="0.5" value="4" class="h-11 w-full cursor-pointer accent-accent disabled:cursor-not-allowed" />
      </div>
    </fieldset>

    <SaveActions locale={locale} />
  </div>
</div>

<script>
  // Tailwind Plus Elements: only the editor uses it (the format's <el-select>),
  // so only pages with the editor load it.
  import "@tailwindplus/elements"
  import { mountEditor } from "../lib/editor"

  document.querySelectorAll<HTMLElement>("[data-editor]").forEach(mountEditor)
</script>
